[Unit]
Description=BottleNeck self-hosted team workspace
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bottleneck
Group=bottleneck
WorkingDirectory=/opt/bottleneck/bottleneck-mvp
Environment=BOTTLENECK_ENV=production
Environment=BOTTLENECK_ENABLE_API_DOCS=0
Environment=BOTTLENECK_HOST=127.0.0.1
Environment=BOTTLENECK_PORT=1939
Environment=BOTTLENECK_COOKIE_SECURE=1
Environment=BOTTLENECK_TRUSTED_PROXY_IPS=127.0.0.1
Environment=BOTTLENECK_ALLOWED_ORIGINS=https://workspace.example.com
ExecStart=/opt/bottleneck/bottleneck-mvp/.venv/bin/python /opt/bottleneck/bottleneck-mvp/bottleneck_cli.py serve --host 127.0.0.1 --port 1939
Restart=on-failure
RestartSec=5
TimeoutStopSec=35
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/bottleneck/bottleneck-mvp/data /opt/bottleneck/bottleneck-mvp/backups /opt/bottleneck/bottleneck-mvp/logs

[Install]
WantedBy=multi-user.target
