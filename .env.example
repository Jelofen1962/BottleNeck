# Runtime mode. Production mode disables public API docs by default.
BOTTLENECK_ENV=production
BOTTLENECK_ENABLE_API_DOCS=0

# Listen on all interfaces for a trusted LAN. Default application port: 1939.
BOTTLENECK_HOST=0.0.0.0
BOTTLENECK_PORT=1939

# Set to 1 only when HTTPS is enabled directly in Uvicorn.
BOTTLENECK_COOKIE_SECURE=0
# If running behind a reverse proxy, list exact public origins, comma-separated.
# BOTTLENECK_ALLOWED_ORIGINS=https://workspace.example.com

# Optional custom storage locations. Keep these directories private and backed up.
# BOTTLENECK_DB=./data/bottleneck.sqlite3
# BOTTLENECK_UPLOAD_DIR=./data/uploads
# BOTTLENECK_SHARED_DIR=./data/shared
# BOTTLENECK_BACKUP_DIR=./backups

BOTTLENECK_BACKUP_INTERVAL_HOURS=24
BOTTLENECK_BACKUP_RETENTION=14

# Optional SMTP settings for password reset and notification email.
# BOTTLENECK_SMTP_HOST=
# BOTTLENECK_SMTP_PORT=587
# BOTTLENECK_SMTP_USER=
# BOTTLENECK_SMTP_PASSWORD=
# BOTTLENECK_SMTP_FROM=
# BOTTLENECK_SMTP_STARTTLS=1
